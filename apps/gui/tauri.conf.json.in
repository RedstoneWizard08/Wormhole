{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Wormhole",
    "version": "<version>",
    "identifier": "io.github.redstonewizard08.wormhole",
    "app": {
        "withGlobalTauri": true,
        "security": {
            "csp": null
        },
        "windows": [
            {
                "fullscreen": false,
                "height": 800,
                "width": 1200,
                "resizable": true,
                "title": "Wormhole",
                "minHeight": 400,
                "minWidth": 600,
                "maximized": true,
                "theme": "Dark"
            }
        ]
    },
    "build": {
        "beforeDevCommand": "pnpm app:dev",
        "beforeBuildCommand": "pnpm app:build",
        "devUrl": "http://localhost:1420",
        "frontendDist": "<root>/build"
    },
    "bundle": {
        "active": true,
        "category": "Utility",
        "copyright": "",
        "externalBin": [],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "longDescription": "",
        "resources": [],
        "shortDescription": "A centralized multi-game mod and modpack manager and launcher, supporting Steam, Minecraft, and the Private Division launcher.",
        "targets": "all",
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        },
        "linux": {
            "appimage": {
                "bundleMediaFramework": false,
                "files": {}
            },
            "deb": {
                "files": {}
            },
            "rpm": {
                "epoch": 0,
                "files": {},
                "release": "1"
            }
        },
        "macOS": {
            "entitlements": null,
            "exceptionDomain": "",
            "frameworks": [],
            "providerShortName": null,
            "signingIdentity": null
        }
    }
}
